{
  "manifest_version": 3,
  "name": "ApplyFlow \u2014 Autofill & Job Resumes",
  "version": "2.1.0",
  "description": "Autofill applications and create a one-page job-specific resume with unchanged original bullets.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApplyFlow"
  },
  "options_page": "profile.html",
  "background": {
    "service_worker": "background.js"
  },
  "key": "",
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
