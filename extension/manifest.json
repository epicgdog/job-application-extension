{
  "manifest_version": 3,
  "name": "ApplyFlow — Application Autofill",
  "version": "1.0.0",
  "description": "Fill application forms from your saved profile, with a field-by-field preview.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {"default_popup": "popup.html", "default_title": "ApplyFlow"},
  "options_page": "profile.html",
  "background": {"service_worker": "background.js"}
}
