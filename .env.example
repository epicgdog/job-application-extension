# Copy this file to .env. Local mode works without any Supabase account.
# Run python scripts/build.py after changing client settings, then reload extension.
APPLYFLOW_LOCAL_MODE=true
APPLYFLOW_API_BASE_URL=http://127.0.0.1:8000
APPLYFLOW_API_HOST=127.0.0.1
APPLYFLOW_API_PORT=8000
# Omit this variable to use the stable extension ID from manifest.json automatically.
# APPLYFLOW_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# For private cloud storage: set local mode false, create your Supabase project,
# run supabase/001_initial.sql, and fill these values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# UUID from Supabase Authentication -> Users, not a project reference or API key.
# This private backend serves only your account.
APPLYFLOW_OWNER_USER_ID=
SUPABASE_RESUME_BUCKET=resumes
SUPABASE_SOURCE_BUCKET=resume-sources
# No secret/service-role/admin key is used or bundled by this app.

# Fictional examples run from a clean clone. Keep real inputs under private-data/.
APPLYFLOW_PROFILE_PATH=./examples/profile.json
APPLYFLOW_RESUME_LIBRARY_PATH=./examples/resume-library.json
APPLYFLOW_MASTER_RESUME_PATH=./private-data/master.pdf
APPLYFLOW_DATA_DIR=./.data

# Layout is enforced by the renderer: US Letter, exactly one page, 10 pt body,
# 36 pt margins. These bounds cannot be overridden by job descriptions.
